<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="UiInk" Color="#1A1A1A" />
  <SolidColorBrush x:Key="UiMuted" Color="#5C5C5C" />
  <SolidColorBrush x:Key="UiLine" Color="#262626" />
  <SolidColorBrush x:Key="UiCanvas" Color="#F5F5F5" />
  <SolidColorBrush x:Key="UiPaper" Color="#FFFFFF" />
  <SolidColorBrush x:Key="UiPink" Color="#F472B6" />
  <SolidColorBrush x:Key="UiSky" Color="#38BDF8" />
  <SolidColorBrush x:Key="UiPinkTint" Color="#FDEAF4" />
  <SolidColorBrush x:Key="UiSkyTint" Color="#E1F5FE" />
  <SolidColorBrush x:Key="UiLimeTint" Color="#F1FBDD" />
  <SolidColorBrush x:Key="UiAmberTint" Color="#FEF5DD" />
  <SolidColorBrush x:Key="UiShadow" Color="#33000000" />
  <SolidColorBrush x:Key="UiSuccess" Color="#385612" />
  <SolidColorBrush x:Key="UiWarning" Color="#74521A" />
  <SolidColorBrush x:Key="UiError" Color="#9B325C" />

  <Style x:Key="UiHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
  </Style>
  <Style x:Key="UiLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
  </Style>
  <Style x:Key="UiCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource UiMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>

  <Style x:Key="UiCard" TargetType="ContentControl">
    <Setter Property="Background" Value="{StaticResource UiPaper}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid Background="Transparent">
            <Border x:Name="CardShadow" Background="{StaticResource UiShadow}" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform X="4" Y="4" /></Border.RenderTransform>
            </Border>
            <Border x:Name="CardFace" Background="{TemplateBinding Background}" BorderBrush="{StaticResource UiLine}"
                    BorderThickness="2" Padding="{TemplateBinding Padding}">
              <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
              <ContentPresenter />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CardFace" Property="BorderBrush" Value="{StaticResource UiPink}" />
              <Setter TargetName="CardShadow" Property="Background" Value="#3D000000" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="6" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="6" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="CardFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="4" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="4" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="CardFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource UiPaper}" />
    <Setter Property="BorderBrush" Value="{StaticResource UiLine}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="UiBadge" TargetType="Border" BasedOn="{StaticResource UiPanel}">
    <Setter Property="Background" Value="{StaticResource UiLimeTint}" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource UiPaper}" />
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="ButtonBody" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                  <VisualTransition GeneratedDuration="0:0:0.15">
                    <VisualTransition.GeneratedEasingFunction><QuadraticEase EasingMode="EaseOut" /></VisualTransition.GeneratedEasingFunction>
                  </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal" />
                <VisualState x:Name="MouseOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="ShadowOffset" Storyboard.TargetProperty="X" To="6" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="ShadowOffset" Storyboard.TargetProperty="Y" To="6" Duration="0" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="FaceOffset" Storyboard.TargetProperty="X" To="4" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="FaceOffset" Storyboard.TargetProperty="Y" To="4" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="ButtonShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="ButtonShadow" Background="{StaticResource UiShadow}" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform x:Name="ShadowOffset" X="4" Y="4" /></Border.RenderTransform>
            </Border>
            <Grid>
              <Grid.RenderTransform><TranslateTransform x:Name="FaceOffset" /></Grid.RenderTransform>
              <Border Background="{TemplateBinding Background}" />
              <Border x:Name="HoverFill" Background="{StaticResource UiPink}" Opacity="0" />
              <Border x:Name="ButtonFrame" BorderBrush="{StaticResource UiLine}" BorderThickness="2" />
              <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{StaticResource UiSky}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="UiPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel IsItemsHost="True" Orientation="Horizontal" Margin="24,0,24,10" KeyboardNavigation.TabIndex="1" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="Margin" Value="0,0,12,5" />
    <Setter Property="MinWidth" Value="82" />
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid>
            <Border Background="{StaticResource UiShadow}" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform X="3" Y="3" /></Border.RenderTransform>
            </Border>
            <Border x:Name="TabFace" Background="{StaticResource UiPaper}" BorderThickness="2" BorderBrush="{StaticResource UiLine}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{StaticResource UiPinkTint}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{StaticResource UiPink}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFace" Property="BorderBrush" Value="{StaticResource UiSky}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="UiField" TargetType="Control">
    <Grid>
      <Border x:Name="FieldShadow" Background="{StaticResource UiShadow}" Visibility="Hidden" IsHitTestVisible="False">
        <Border.RenderTransform><TranslateTransform X="4" Y="4" /></Border.RenderTransform>
      </Border>
      <Border x:Name="FieldFace" Background="{StaticResource UiPaper}" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="{StaticResource UiLine}">
        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="FieldFace" Property="BorderBrush" Value="{StaticResource UiSky}" />
        <Setter TargetName="FieldShadow" Property="Visibility" Value="Visible" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Template" Value="{StaticResource UiField}" />
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Template" Value="{StaticResource UiField}" />
  </Style>

  <ControlTemplate x:Key="UiChoice" TargetType="ToggleButton">
    <StackPanel Orientation="Horizontal" Background="Transparent">
      <Border x:Name="ChoiceFace" Width="18" Height="18" Background="{StaticResource UiPaper}"
              BorderBrush="{StaticResource UiLine}" BorderThickness="2" VerticalAlignment="Center">
        <Rectangle x:Name="SelectionMark" Width="8" Height="8" Fill="{StaticResource UiInk}" Visibility="Hidden" />
      </Border>
      <ContentPresenter Margin="8,0,0,0" RecognizesAccessKey="True" VerticalAlignment="Center" />
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="ChoiceFace" Property="Background" Value="{StaticResource UiPink}" />
        <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFace" Property="BorderBrush" Value="{StaticResource UiPink}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceFace" Property="BorderBrush" Value="{StaticResource UiSky}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Template" Value="{StaticResource UiChoice}" />
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource UiInk}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template" Value="{StaticResource UiChoice}" />
  </Style>

  <ControlTemplate x:Key="UiSliderHitArea" TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
  <Style x:Key="UiSlider" TargetType="Slider">
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border x:Name="SliderRail" Height="6" Background="#E5E5E5" BorderBrush="{StaticResource UiLine}"
                    BorderThickness="1" VerticalAlignment="Center" />
            <Track x:Name="PART_Track" Orientation="Horizontal">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Template="{StaticResource UiSliderHitArea}" Focusable="False" /></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Template="{StaticResource UiSliderHitArea}" Focusable="False" /></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="20" Height="20" Cursor="SizeWE">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Border Background="{StaticResource UiShadow}"><Border.RenderTransform><TranslateTransform X="2" Y="2" /></Border.RenderTransform></Border>
                        <Border Background="{StaticResource UiPink}" BorderBrush="{StaticResource UiLine}" BorderThickness="2" />
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderRail" Property="BorderBrush" Value="{StaticResource UiSky}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
