<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="SteamCN.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown" xmlns:app="clr-namespace:SteamCN.App;assembly=SteamCN.App">
  <Application.Resources>
    <ResourceDictionary>
      <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#888" />
        <Setter Property="Margin" Value="4" />
      </Style>
      <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>